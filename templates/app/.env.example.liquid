# Compose publishes the app on this host address.
{{env_prefix}}_PUBLISH_ADDRESS=127.0.0.1

# Listener and SQLite database. Compose overrides the database path.
{{env_prefix}}_LISTEN_ADDR=127.0.0.1:8080
{{env_prefix}}_DATABASE_URL=sqlite://data/{{project-name}}.db?mode=rwc

# Set to true behind HTTPS.
{{env_prefix}}_COOKIE_SECURE=false

# Browser session lifetime, in days (1 to 365).
{{env_prefix}}_SESSION_DAYS=30

# Token for creating the first account. When unset, one is generated at startup
# and logged while no account exists.
# {{env_prefix}}_SETUP_TOKEN=

# Comma-separated reverse proxy addresses allowed to set X-Forwarded-For.
# {{env_prefix}}_TRUSTED_PROXIES=

# Requests per minute from one client address.
{{env_prefix}}_RATE_LIMIT_PER_SOURCE=600

# Read templates and static files from disk, for development. Leave these out in
# production, where both are inside the binary.
{{env_prefix}}_TEMPLATE_DIR=src/templates
{{env_prefix}}_STATIC_DIR=src/static

RUST_LOG=info,sqlx=warn
