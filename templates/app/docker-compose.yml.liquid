services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    image: {{project-name}}:local
    restart: unless-stopped
    init: true
    environment:
      {{env_prefix}}_LISTEN_ADDR: 0.0.0.0:8080
      {{env_prefix}}_DATABASE_URL: sqlite:///data/{{project-name}}.db?mode=rwc
      {{env_prefix}}_COOKIE_SECURE: ${% raw %}{{% endraw %}{{env_prefix}}_COOKIE_SECURE:-false}
      {{env_prefix}}_SESSION_DAYS: ${% raw %}{{% endraw %}{{env_prefix}}_SESSION_DAYS:-30}
      {{env_prefix}}_SETUP_TOKEN: ${% raw %}{{% endraw %}{{env_prefix}}_SETUP_TOKEN:-}
      {{env_prefix}}_TRUSTED_PROXIES: ${% raw %}{{% endraw %}{{env_prefix}}_TRUSTED_PROXIES:-}
      RUST_LOG: ${RUST_LOG:-{{crate_name}}=info}
    ports:
      - "${% raw %}{{% endraw %}{{env_prefix}}_PUBLISH_ADDRESS:-127.0.0.1}:8080:8080"
    volumes:
      - app-data:/data
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    stop_grace_period: 15s
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:8080/ready"]
      interval: 30s
      timeout: 5s
      start_period: 10s
      retries: 3

volumes:
  app-data:
